{
  "name": "brightcare-quote-calculator",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Commit to Production session - Group A (TypeScript)",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "lint": "node --experimental-strip-types --no-warnings scripts/lint.ts",
    "test": "node --experimental-strip-types --no-warnings --test test/premium.test.ts test/quote.test.ts",
    "build": "node --experimental-strip-types --no-warnings scripts/build.ts",
    "deploy": "node --experimental-strip-types --no-warnings scripts/deploy.ts",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke.ts",
    "secret-scan": "node --experimental-strip-types --no-warnings scripts/secret-scan.ts",
    "quote": "node --experimental-strip-types --no-warnings scripts/quote.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "//": "npm install is only needed for `npm run typecheck`. Everything else runs with plain Node 22.6+."
}
